{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthRecord",
  "description": "Cấu trúc 1 hồ sơ khám sức khỏe định kỳ, tương ứng 1 dòng trong file mẫu admin-ui/mau_import_ksk.xlsx. Không đưa dữ liệu thật vào file này.",
  "type": "object",
  "required": ["full_name", "employee_code", "dob"],
  "properties": {
    "stt": { "type": "string", "description": "Số thứ tự trong danh sách khám (cột stt)" },
    "full_name": { "type": "string", "description": "Họ và tên (cột họ_và_tên)" },
    "employee_code": { "type": "string", "pattern": "^[A-Z0-9]{1,20}$", "description": "Mã nhân viên, yếu tố xác thực 1 (cột mã_nhân_viên)" },
    "gender": { "type": "string", "description": "Giới tính (cột giới_tính)" },
    "dob": { "type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$", "description": "Ngày sinh DD/MM/YYYY, yếu tố xác thực 2 (cột ngày_sinh)" },
    "job_title": { "type": "string", "description": "Chức danh (cột chức_danh)" },
    "department": { "type": "string", "description": "Bộ phận (cột bộ_phận)" },
    "unit_name": { "type": "string", "description": "Đơn vị (cột đơn_vị)" },
    "height": { "type": "string", "description": "Chiều cao, cm" },
    "weight": { "type": "string", "description": "Cân nặng, kg" },
    "physical": { "type": "string", "description": "Phân loại thể lực" },
    "blood_pressure": { "type": "string", "description": "Huyết áp, mmHg" },
    "vision_right": { "type": "string" },
    "vision_left": { "type": "string" },
    "vision_disease": { "type": "string" },
    "ent": { "type": "string", "description": "Tai mũi họng" },
    "dental": { "type": "string", "description": "Răng hàm mặt" },
    "dermatology": { "type": "string", "description": "Nội - da liễu" },
    "surgery": { "type": "string", "description": "Ngoại khoa" },
    "xray": { "type": "string", "description": "X-quang" },
    "ultrasound": { "type": "string", "description": "Siêu âm ổ bụng" },
    "gynecology": { "type": "string", "description": "Phụ khoa" },
    "blood_tests": {
      "type": "object",
      "properties": {
        "ctm": { "type": "string" }, "urine": { "type": "string" }, "acid_uric": { "type": "string" },
        "creatinin": { "type": "string" }, "glucose": { "type": "string" }, "ure": { "type": "string" },
        "sgot": { "type": "string" }, "sgpt": { "type": "string" }, "triglycerides": { "type": "string" },
        "cholesterol": { "type": "string" }, "ggt": { "type": "string" }, "morphin": { "type": "string" }
      }
    },
    "health_class": { "type": "string", "description": "Phân loại sức khỏe (Loại I–V)" },
    "conclusion": { "type": "string", "description": "Kết luận" },
    "medical_advice": { "type": "string", "description": "Tư vấn của bác sĩ" }
  }
}
